{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "bash": {
      "*": "ask",
      "rm *": "deny",
      "rmdir *": "deny",
      "unlink *": "deny",
      "git rm *": "deny",
      "find * -delete": "deny",
      "find * -exec rm": "deny"
    },
    "external_directory": {
      "**": "deny"
    }
  }
}
